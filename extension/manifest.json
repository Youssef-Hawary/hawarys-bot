{
  "manifest_version": 3,
  "name": "Hawary's Bot",
  "version": "1.2.0",
  "description": "Connects your Eldorado tab to Hawary's Bot: reads request details, records Eldorado calls, sends auto-chat messages.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Hawary's Bot" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.eldorado.gg/*", "https://eldorado.gg/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    { "matches": ["https://www.eldorado.gg/*", "https://eldorado.gg/*"], "js": ["inject.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://www.eldorado.gg/*", "https://eldorado.gg/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
